{
  "name": "empty-editor-watermark",
  "displayName": "Empty Editor Watermark",
  "description": "给空编辑器铺自定义背景图（水印）。以独立 Webview 页实现：不修改 VS Code 安装目录，不会触发「安装似乎损坏」。",
  "version": "0.2.0",
  "publisher": "YuHaoran251",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "watermark",
    "background",
    "wallpaper",
    "empty editor",
    "customization"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/michalrees/empty-editor-watermark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "emptyEditorWatermark.show",
        "title": "显示水印",
        "category": "Watermark"
      },
      {
        "command": "emptyEditorWatermark.hide",
        "title": "关闭水印",
        "category": "Watermark"
      },
      {
        "command": "emptyEditorWatermark.pickImage",
        "title": "选择背景图…",
        "category": "Watermark"
      },
      {
        "command": "emptyEditorWatermark.showCss",
        "title": "查看水印页源码",
        "category": "Watermark"
      },
      {
        "command": "emptyEditorWatermark.remove",
        "title": "清理旧版注入（0.1.x 写进安装目录的样式）",
        "category": "Watermark"
      },
      {
        "command": "emptyEditorWatermark.apply",
        "title": "显示/刷新水印（0.1.x 兼容别名）",
        "category": "Watermark"
      }
    ],
    "configuration": {
      "title": "Empty Editor Watermark",
      "properties": {
        "emptyEditorWatermark.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "总开关。关闭后不再自动显示水印页，并关闭已打开的水印页。"
        },
        "emptyEditorWatermark.autoOpen": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "编辑器区域为空时自动打开水印页。"
        },
        "emptyEditorWatermark.closeWhenEditorOpens": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "打开文件后自动关闭水印页（更接近 VS Code 内置水印的行为）。"
        },
        "emptyEditorWatermark.panelTitle": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "水印页的标签页标题。留空 = 按界面语言自动（水印 / Watermark）。"
        },
        "emptyEditorWatermark.imagePath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "背景图的绝对路径（留空 = 用扩展自带的自制默认图）。支持 ~ 前缀、file:/// 写法与 http(s) 地址。图片不被复制，就地读取。"
        },
        "emptyEditorWatermark.imageFit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ],
          "default": "cover",
          "description": "cover = 放大铺满、超出部分裁掉；contain = 完整装下、必然有一边留白。"
        },
        "emptyEditorWatermark.opacity": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "背景图透明度（0.1 很淡，1 完全不透明）。只影响图片，不影响页面上的文字。"
        },
        "emptyEditorWatermark.position": {
          "type": "string",
          "enum": [
            "top-right",
            "top-left",
            "bottom-right",
            "bottom-left",
            "center"
          ],
          "default": "top-right",
          "description": "文字块（标识文字 + 命令列表）的位置。hideLogo 与 hideCommands 都为 true 时无视觉影响。"
        },
        "emptyEditorWatermark.scale": {
          "type": "number",
          "default": 0.48,
          "minimum": 0.05,
          "maximum": 4,
          "description": "文字块的缩放（transform: scale）。只影响文字块，不影响背景图。"
        },
        "emptyEditorWatermark.hideLogo": {
          "type": "boolean",
          "default": true,
          "description": "隐藏文字块顶部的标识文字（默认只留背景图）。"
        },
        "emptyEditorWatermark.hideCommands": {
          "type": "boolean",
          "default": true,
          "description": "隐藏文字块里的命令列表（显示所有命令 / 打开文件 / 克隆 Git 仓库）。"
        },
        "emptyEditorWatermark.panelWidth": {
          "type": "number",
          "default": 261,
          "description": "文字块宽度（px）。"
        },
        "emptyEditorWatermark.panelFontSize": {
          "type": "number",
          "default": 19,
          "description": "文字块基准字号（px），会与 scale 叠加。"
        },
        "emptyEditorWatermark.frostedPanel": {
          "type": "boolean",
          "default": false,
          "description": "给文字块加半透明磨砂底（图片较花、文字不好认时开启）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "npm run compile && node tools/check-page.js && node tools/check-legacy.js && node tools/check-apply.js",
    "release": "pwsh -NoProfile -File tools/release.ps1",
    "release:dry": "pwsh -NoProfile -File tools/release.ps1 -DryRun",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
